# Vercel AI Gateway — authenticates the model call in agent/agent.ts.
# Create a key at https://vercel.com/dashboard/ai-gateway, or run `eve link`
# to pull credentials from a linked Vercel project instead.
AI_GATEWAY_API_KEY=

# GitHub personal access token (classic or fine-grained), read-only.
# Optional for public repositories, but strongly recommended:
#   - without it, GitHub allows only 60 API requests/hour (5,000 with it)
#   - code search does not work at all for anonymous callers
#   - private repositories require it
# Create one at https://github.com/settings/tokens with `public_repo`
# (or `repo` if you want the agent to read your private repositories).
GITHUB_TOKEN=

# Optional Postgres connection for production or multi-instance deployments.
# When omitted, Repo Reader creates a local SQLite database automatically.
DATABASE_URL=

# Optional SQLite file location. Defaults to .data/repo-reader.db.
# The containing directory must be on persistent storage in production.
REPO_READER_DB_PATH=
